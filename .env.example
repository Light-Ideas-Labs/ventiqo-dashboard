# Backend API base URL — mirrors the ventiqo-backend-api environments.
# Per-environment values live in .env.development / .env.staging / .env.sandbox / .env.production
# (loaded automatically, or via `npm run dev:staging` etc.). Set here only to override locally.
# development: http://localhost:5000/api/v1
# staging:     https://ventiqo-backend-api-staging.onrender.com/api/v1
# sandbox:     https://ventiqo-backend-api-sandbox.onrender.com/api/v1
# production:  https://ventiqo-backend-api.onrender.com/api/v1
NEXT_PUBLIC_BASE_URL=

# uploadthing v7 — get a token from https://uploadthing.com/dashboard (Api Keys)
UPLOADTHING_TOKEN=

# Next auth https://next-auth.js.org/configuration/options
# Run this command to generate a a new NEXTAUTH_SECRET
# $ openssl rand -base64 32

NEXTAUTH_URL = http://localhost:3000
NEXTAUTH_SECRET=

# Go to github and setup the oauth configuration
# https://next-auth.js.org/providers/github#configuration
# https://github.com/settings/developers

GITHUB_ID = 
GITHUB_SECRET = 